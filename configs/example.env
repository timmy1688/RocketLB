ROCKETLB_HTTP_ADDR=:8080
ROCKETLB_ENV=debug
ROCKETLB_DATA_DIR=data
ROCKETLB_DB_DRIVER=postgres
ROCKETLB_DB_DSN=postgres://rocketlb:rocketlb@127.0.0.1:5432/rocketlb?sslmode=disable
ROCKETLB_ADMIN_USER=admin
ROCKETLB_ADMIN_PASSWORD=change-me
# 生产用 Compose 时在环境变量里提供这两个值，控制面不把密钥写到挂载目录。
# ROCKETLB_DATA_KEY 是 32 字节的 base64。
# ROCKETLB_JWT_SECRET=
# ROCKETLB_DATA_KEY=
# ROCKETLB_WEB_DIST=web/dist
